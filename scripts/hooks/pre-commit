#!/usr/bin/env python3
"""Two checks before a commit lands: nothing personal, and nothing broken.

1. Refuse a commit containing something the companion learned about you.
2. Refuse a commit that fails the backend test suite.

Written after one of the user's real quirks went into a test fixture as what
looked like an invented example, and was caught by a manual scan one step
before it went public. Test data is the leak path nobody watches: a tuple of
three plausible-sounding hobbies does not read as personal data, which is
exactly the problem.

Deliberately not naming the topic here. This file gets committed, and writing
it down to explain the tool would be the same mistake the tool exists to
prevent -- as this hook pointed out when it blocked its own first commit.

The topics live in gitignored files and are read fresh on every run, so this
script holds none of them and is safe to commit. On a clone with no data --
anyone else's machine, CI -- there is nothing to compare against and the hook
passes without comment.

Install:  git config core.hooksPath scripts/hooks
Bypass:   git commit --no-verify        (after checking the hit is a false one)
"""
import json
import os
import re
import subprocess
import sys

#: The app's own schema words -- quirk categories from ANALYSIS_PROMPT and
#: the kinds in sensitivities.KINDS. They collide with real topics by
#: coincidence, and they already appear throughout committed source, so
#: matching on them would make the hook fire constantly and get ignored.
#:
#: THE RULE: only schema words go in here, never a topic. The category
#: "food" is general enough to be app vocabulary; a specific food someone
#: mentioned is exactly what this hook exists to catch, and adding one here
#: would quietly punch a hole in the thing. If a real topic keeps tripping a
#: false positive, rename the fixture -- do not widen this set.
APP_VOCABULARY = {
    'music', 'food', 'sports', 'hobby', 'media', 'place',
    'health', 'substance', 'family', 'relationship', 'grief',
    'money', 'work', 'other',
}

#: Below this, a topic is too short to match anything but noise.
MIN_LENGTH = 3


def repo_root():
    return subprocess.check_output(
        ['git', 'rev-parse', '--show-toplevel'], text=True).strip()


def app_suggested_names(root):
    """The names the app itself offers in setup's "choose for me" list.

    A name this app hands to everyone cannot identify anyone. One of them is
    also, in committed source, the fixture name in nine tests and an entry in
    setup.js -- all of it predating any real companion. Flagging a companion
    called one of these would fire on the app's own copy forever, and a hook
    that cries wolf is a hook people stop reading.

    Read from source rather than duplicated here, so the two cannot drift.
    An unreadable list returns nothing, which guards the name as before --
    the conservative direction.

    **Applied to the companion's name and nothing else.** A quirk spelled
    like one of these is still a thing the user said out loud, and is still
    caught.
    """
    path = os.path.join(root, 'frontend', 'src', 'copy', 'setup.js')
    try:
        with open(path) as f:
            block = re.search(r'RANDOM_NAMES\s*=\s*\[(.*?)\]', f.read(), re.S)
        return {n.lower() for n in re.findall(r"['\"]([^'\"]+)['\"]", block.group(1))}
    except Exception:                                        # noqa: BLE001
        return set()


def learned_topics(root):
    """Everything the companion knows, as plain lowercase strings."""
    data_dir = os.path.join(root, 'backend', 'data')
    topics = set()

    for name in ('quirks.json', 'sensitivities.json'):
        path = os.path.join(data_dir, name)
        if os.path.exists(path):
            with open(path) as f:
                topics |= {str(k).lower() for k in json.load(f)}

    character = os.path.join(data_dir, 'character.json')
    if os.path.exists(character):
        with open(character) as f:
            name = json.load(f).get('name')
        # Only the name gets this exemption; topics never do.
        if name and str(name).lower() not in app_suggested_names(root):
            topics.add(str(name).lower())

    return {t for t in topics
            if len(t) >= MIN_LENGTH and t not in APP_VOCABULARY}


def added_lines():
    """Every line this commit adds, paired with the file it lands in."""
    diff = subprocess.check_output(
        ['git', 'diff', '--cached', '-U0'], text=True, errors='replace')

    current = '?'
    for line in diff.splitlines():
        if line.startswith('+++ b/'):
            current = line[6:]
        elif line.startswith('+') and not line.startswith('+++'):
            yield current, line[1:]


def run_tests(root):
    """The backend suite. Offline, no API calls, well under a second.

    Skipped rather than failed when the virtualenv isn't there: a fresh
    clone has no venv yet, and blocking every commit until someone runs
    `pip install` would make the hook the first thing they delete. The
    privacy check above has no such escape, because that one is a promise
    and this one is a habit.
    """
    python = os.path.join(root, 'venv', 'bin', 'python')
    if not os.path.exists(python):
        print('pre-commit: no venv found, skipping tests.')
        return 0

    result = subprocess.run(
        [python, '-m', 'pytest', '-q'],
        cwd=os.path.join(root, 'backend'),
        capture_output=True, text=True,
    )
    if result.returncode == 0:
        print(f'pre-commit: {result.stdout.strip().splitlines()[-1]}')
        return 0

    print()
    print('  The backend tests do not pass.')
    print()
    for line in result.stdout.strip().splitlines()[-15:]:
        print(f'    {line}')
    print()
    print('  Fix them, or commit anyway with:')
    print('    git commit --no-verify')
    print()
    return 1


def check_personal_data(root):
    try:
        topics = learned_topics(root)
    except Exception as e:                                   # noqa: BLE001
        # Fail closed. A privacy guard that waves things through when it
        # breaks is worse than one that occasionally needs --no-verify.
        print(f'pre-commit: could not read local data ({e}).')
        print('Commit blocked. Use --no-verify if you are sure.')
        return 1

    if not topics:
        return 0

    # Whole-word, case-insensitive. A known gap, left open deliberately:
    # a name is caught in any capitalisation, but not with a suffix glued
    # on -- `name2` or `name-test` slip through. Substring matching would
    # close that and would also fire on every ordinary word containing a
    # short topic, which is how a hook stops being trusted. Revisit only
    # if a near-miss gets through -- this comment is then the reminder.
    patterns = [(t, re.compile(rf'\b{re.escape(t)}\b', re.I)) for t in topics]
    hits = []
    for path, line in added_lines():
        for topic, pattern in patterns:
            if pattern.search(line):
                hits.append((path, topic, line.strip()[:70]))

    if not hits:
        return 0

    print()
    print('  Something your companion learned about you is in this commit.')
    print()
    for path, topic, line in hits[:12]:
        print(f'    {path}')
        print(f'      {topic!r}  ->  {line}')
    if len(hits) > 12:
        print(f'    ... and {len(hits) - 12} more')
    print()
    print('  These come from your local quirks/sensitivities and are never')
    print('  committed themselves -- but a copy in source code would be.')
    print()
    print('  Rename it to something invented, or if this is a coincidence:')
    print('    git commit --no-verify')
    print()
    return 1


def main():
    root = repo_root()
    # Privacy first: it is the cheaper check and the one that matters more.
    # A commit that leaks something personal is not fixed by passing tests.
    return check_personal_data(root) or run_tests(root)


if __name__ == '__main__':
    sys.exit(main())
