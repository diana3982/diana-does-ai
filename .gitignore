# Virtual environment
venv/

# Python cache files
__pycache__/
*.pyc

# Environment variables — API keys live here, never commit
.env
.env.*
!.env.example

# ─────────────────────────────────────────
# PRIVATE USER DATA — never commit
# ─────────────────────────────────────────
# What someone tells their companion, and what it learns about them,
# stays on their machine. The *.example.json files are committed
# instead so the data shapes are documented publicly.
# See backend/data/README.md
backend/data/*.json
!backend/data/*.example.json
# Token counts from real sessions. Numbers only, never content --
# but it is still a record of when someone talked to their companion,
# and that is theirs. The *.json rule above does not cover .jsonl.
backend/data/*.jsonl

# Test mode writes here instead of over someone's real companion.
backend/data/test/

# Node
node_modules/
dist/

# Mac junk
.DS_Store

# Test tooling scratch
.pytest_cache/
__pycache__/

# Test run logs. These stay on the machine that produced them -- everything
# in the directory is ignored regardless of name or extension, so a log can
# never be pushed by accident. Only the README explaining it is tracked.
backend/tests/logs/*
!backend/tests/logs/README.md
